{
  "name": "jarvis-tui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "jarvis": "./src/index.tsx"
  },
  "scripts": {
    "setup": "./install.sh",
    "start": "bun run src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "schema": "bun run scripts/emit-schema.ts",
    "compile": "bun build --compile --outfile dist/jarvis src/index.tsx && rm -f .*.bun-build"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.2.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "ai": "^7.0.42",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  }
}
