{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "jarvis config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "smallModel": {
      "type": "string"
    },
    "agent": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "promptFile": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "tools": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "defaultTools": {
            "default": true,
            "type": "boolean"
          },
          "permission": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ask",
                "allow",
                "deny"
              ]
            }
          },
          "spawnable": {
            "default": true,
            "type": "boolean"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "provider": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "npm": {
            "type": "string"
          },
          "export": {
            "type": "string"
          },
          "options": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "models": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "options": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "reasoning": {
                  "type": "boolean"
                },
                "contextLimit": {
                  "type": "number"
                },
                "outputLimit": {
                  "type": "number"
                },
                "cost": {
                  "description": "USD per million tokens, used for the status line estimate",
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "input",
                    "output"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "npm"
        ],
        "additionalProperties": false
      }
    },
    "mcp": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "local"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "environment": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "remote"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "permission": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "ask",
          "allow",
          "deny"
        ]
      }
    },
    "keybinds": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "theme": {
      "default": "jarvis",
      "type": "string"
    },
    "instructions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxSteps": {
      "default": 200,
      "type": "number"
    }
  },
  "additionalProperties": false
}
