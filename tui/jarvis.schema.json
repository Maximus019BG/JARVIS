{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "jarvis config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "smallModel": {
      "type": "string"
    },
    "agent": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "promptFile": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "tools": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "defaultTools": {
            "default": true,
            "type": "boolean"
          },
          "permission": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ask",
                "allow",
                "deny"
              ]
            }
          },
          "spawnable": {
            "default": true,
            "type": "boolean"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "provider": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "npm": {
            "type": "string"
          },
          "export": {
            "type": "string"
          },
          "options": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "models": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "options": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "reasoning": {
                  "type": "boolean"
                },
                "contextLimit": {
                  "type": "number"
                },
                "outputLimit": {
                  "type": "number"
                },
                "cost": {
                  "description": "USD per million tokens, used for the status line estimate",
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "input",
                    "output"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "npm"
        ],
        "additionalProperties": false
      }
    },
    "mcp": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "local"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "environment": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "remote"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "permission": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "ask",
          "allow",
          "deny"
        ]
      }
    },
    "keybinds": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "theme": {
      "default": "jarvis",
      "type": "string"
    },
    "animations": {
      "default": "full",
      "type": "string",
      "enum": [
        "full",
        "reduced",
        "off"
      ]
    },
    "vim": {
      "default": false,
      "type": "boolean"
    },
    "instructions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "check": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "blueprint": {
      "default": {
        "workspace": "default",
        "pi": {
          "port": 7331,
          "sketch": "sketch",
          "camera": {
            "width": 640,
            "height": 480,
            "fps": 30
          },
          "gestures": {
            "pinchEnter": 0.32,
            "pinchExit": 0.45,
            "debounce": 3,
            "pointHoldMs": 400,
            "minScore": 0.6,
            "zoomDeadZone": 0.08
          },
          "fit": {
            "tolerance": 1.2,
            "smoothing": 0.35,
            "snapGrid": 0,
            "snapRadius": 3
          }
        }
      },
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "workspace": {
          "default": "default",
          "type": "string"
        },
        "pi": {
          "default": {
            "port": 7331,
            "sketch": "sketch",
            "camera": {
              "width": 640,
              "height": 480,
              "fps": 30
            },
            "gestures": {
              "pinchEnter": 0.32,
              "pinchExit": 0.45,
              "debounce": 3,
              "pointHoldMs": 400,
              "minScore": 0.6,
              "zoomDeadZone": 0.08
            },
            "fit": {
              "tolerance": 1.2,
              "smoothing": 0.35,
              "snapGrid": 0,
              "snapRadius": 3
            }
          },
          "type": "object",
          "properties": {
            "port": {
              "default": 7331,
              "type": "number"
            },
            "sketch": {
              "default": "sketch",
              "type": "string"
            },
            "camera": {
              "default": {
                "width": 640,
                "height": 480,
                "fps": 30
              },
              "type": "object",
              "properties": {
                "width": {
                  "default": 640,
                  "type": "number"
                },
                "height": {
                  "default": 480,
                  "type": "number"
                },
                "fps": {
                  "default": 30,
                  "type": "number"
                }
              }
            },
            "gestures": {
              "default": {
                "pinchEnter": 0.32,
                "pinchExit": 0.45,
                "debounce": 3,
                "pointHoldMs": 400,
                "minScore": 0.6,
                "zoomDeadZone": 0.08
              },
              "type": "object",
              "properties": {
                "pinchEnter": {
                  "default": 0.32,
                  "type": "number"
                },
                "pinchExit": {
                  "default": 0.45,
                  "type": "number"
                },
                "debounce": {
                  "default": 3,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "pointHoldMs": {
                  "default": 400,
                  "type": "number"
                },
                "minScore": {
                  "default": 0.6,
                  "type": "number"
                },
                "zoomDeadZone": {
                  "default": 0.08,
                  "type": "number"
                }
              }
            },
            "fit": {
              "default": {
                "tolerance": 1.2,
                "smoothing": 0.35,
                "snapGrid": 0,
                "snapRadius": 3
              },
              "type": "object",
              "properties": {
                "tolerance": {
                  "default": 1.2,
                  "type": "number"
                },
                "smoothing": {
                  "default": 0.35,
                  "type": "number"
                },
                "snapGrid": {
                  "default": 0,
                  "type": "number"
                },
                "snapRadius": {
                  "default": 3,
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "maxSteps": {
      "default": 200,
      "type": "number"
    },
    "maxCost": {
      "default": 0,
      "type": "number"
    },
    "persistGrants": {
      "default": false,
      "type": "boolean"
    },
    "remoteApproval": {
      "default": false,
      "type": "boolean"
    },
    "syncSessions": {
      "default": false,
      "type": "boolean"
    },
    "remoteSteering": {
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
