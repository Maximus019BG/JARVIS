{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.config/jarvis/secrets.json)",
      "Read(~/.local/share/jarvis/credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.config/jarvis/secrets.json)",
      "Edit(~/.local/share/jarvis/credentials.json)",
      "Bash(cat *.env*)",
      "Bash(kubectl get secret *)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git commit --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.ts" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/tools/check-rules.ts docs-touched --worktree --hook"
          }
        ]
      }
    ]
  }
}
